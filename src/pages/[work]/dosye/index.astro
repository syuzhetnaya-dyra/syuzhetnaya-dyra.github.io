---
import Shell from '../../../layouts/Shell.astro';
import Header from '../../../components/Header.astro';
import { dataBySlug, sobrannye } from '../../../data/all.js';
import { to, asset } from '../../../scripts/paths.js';

export function getStaticPaths() {
  return sobrannye.map((slug) => ({ params: { work: slug } }));
}

const { work } = Astro.params;
const { work: rabota, cards } = dataBySlug[work];
---

<Shell title={`Досье героев · ${rabota.title}`} screen="dosye" work={work}>
  <Header work={work} active="dosye" />

  <main class="dosye">
    <header class="ds-head">
      <h1 class="sp-h1">Досье героев</h1>
      <p class="sp-lead">
        Карточка на героя. Тяните колоду или жмите стрелки, чтобы выбрать;
        нажмите на карточку в центре — она развернётся на весь экран.
      </p>
    </header>

    <div class="deck" data-deck tabindex="0" role="group" aria-label="Колода героев">
      <div class="deck__stage">
        <div class="deck__surface" data-grabbing="false" aria-hidden="true"></div>
        {
          cards.map((c, i) => (
            <a
              class="deck__card"
              href={to(`${work}/dosye/${c.id}/`)}
              data-hero={c.id}
              data-i={i}
              aria-label={`Открыть досье: ${c.name}`}
            >
              {/* Вырезанный коллаж, а не полный кадр: карточка — это бумага,
                  на которую он наклеен. И тот же файл, что на развороте, —
                  иначе при переходе снимок подменялся бы другим. */}
              {c.photo ? (
                <img
                  class="deck__img"
                  src={asset(c.photo)}
                  alt=""
                  width="820"
                  height="1230"
                  loading={i > 1 ? 'lazy' : 'eager'}
                  decoding="async"
                  draggable="false"
                  style={`view-transition-name: hero-${c.id}`}
                />
              ) : (
                <span class="deck__img deck__silhouette" aria-hidden="true">
                  {c.initial}
                </span>
              )}
              <span class="deck__plate">
                <span class="deck__name">{c.name}</span>
                <span class="deck__role">{c.aka ? `«${c.aka}»` : c.role}</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="deck__nav">
        <button class="deck__arrow" type="button" data-deck-prev aria-label="Предыдущий герой">
          ←
        </button>
        <span class="deck__counter" data-deck-counter aria-live="polite">1 / {cards.length}</span>
        <button class="deck__arrow" type="button" data-deck-next aria-label="Следующий герой">
          →
        </button>
      </div>

      <div class="deck__act">
        <a class="deck__open" href={to(`${work}/dosye/${cards[0].id}/`)} data-deck-open>
          Открыть досье
          <span class="deck__open-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </main>

  <script>
    import { mountDeck } from '../../../scripts/deck.js';
    import { readDone } from '../../../scripts/progress.js';
    import { mountGlow } from '../../../scripts/glow.js';

    document.addEventListener('astro:page-load', () => {
      mountDeck();
      mountGlow('.deck__stage', '.deck__card');

      // Пройденные герои помечаются на карточках колоды.
      const done = new Set(readDone(document.body.dataset.work));
      document.querySelectorAll('.deck__card').forEach((card) => {
        if (done.has(card.dataset.hero)) card.dataset.done = 'true';
      });
    });
  </script>
</Shell>

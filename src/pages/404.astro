---
import Shell from '../layouts/Shell.astro';
import Header from '../components/Header.astro';
import { published } from '../data/works.js';
import { to } from '../scripts/paths.js';

// Со страницы ошибки ведём не в разделы одного произведения, а ко всем
// открытым: человек мог прийти по ссылке на то, чего ещё нет.
---

<Shell title="Страница не найдена" screen="notfound">
  <Header />

  <main class="nf">
    <p class="nf__code" aria-hidden="true">404</p>
    <h1 class="nf__h">Здесь дыра</h1>
    <p class="nf__lead">
      Страницы по этому адресу нет. Обычно это устаревшая ссылка или опечатка
      в адресе. Вот что открыто сейчас.
    </p>

    <ul class="nf__list">
      {
        published.map((w, i) => (
          <li>
            <a class="nf__row" href={to(`${w.slug}/`)}>
              <span class="nf__num">{w.author.split(' ').pop()}</span>
              <span class="nf__name">{w.title}</span>
              <span class="nf__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="nf__home" href={to('')}>На главную</a>
  </main>
</Shell>

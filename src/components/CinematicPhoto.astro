---
/*
 * CinematicPhoto — одна фотография, которая ведёт себя как кадр.
 *
 * Как вставить в любую страницу:
 *   <CinematicPhoto src="/hero/ionych.jpg" alt="…">
 *     …контент поверх…
 *   </CinematicPhoto>
 *
 * Слои снизу вверх:
 *   plate  — сама фотография, медленный наезд камеры (100 % → 106 %) со
 *            сносом по горизонтали; animation-direction: alternate, поэтому
 *            разворот происходит в точке нулевой скорости и стыка не видно;
 *   light  — тёплая засветка, дышит с другим периодом, чем наезд, — от этого
 *            движение перестаёт читаться как цикл;
 *   fog    — два мягких пятна, ползут ещё на третьем периоде;
 *   grain  — плёночное зерно, шаговая анимация, никаких GIF и картинок:
 *            шум рисует feTurbulence прямо в data-URI;
 *   scrim  — подложка под текст, иначе заголовок тонет в фотографии.
 *
 * Все движущиеся слои двигаются только через transform и opacity — это
 * композитинг на видеокарте, без перерисовки. Периоды взаимно простые
 * (19 / 23 / 31 с), чтобы рисунок не повторялся.
 */
const { src, srcNarrow, alt = '', position = 'center 40%' } = Astro.props;

// Своё правило на этот кадр, а не CSS-переменная с url() внутри.
// Относительный адрес внутри переменной браузер разрешает от того файла
// стилей, который переменную ПОТРЕБЛЯЕТ, а не от страницы, где она задана:
// пока сайт лежит в корне домена, разницы нет, а из подпапки картинка
// уезжает в /_astro/ и не находится. В собственном теге <style> страницы
// адрес считается от самой страницы — как и ожидается.
const uid = `cine-${Math.random().toString(36).slice(2, 9)}`;
const wide = src;
const narrow = srcNarrow || src;

// Снимка может не быть: произведение собрано, а картинки ещё не нарисованы.
// Пустой url('') браузер считает ссылкой на саму страницу и грузит её
// второй раз — поэтому при отсутствии снимка правило не пишется вовсе, а
// кадр остаётся бумагой.
const estSnimok = Boolean(wide);
---

{
  estSnimok && (
    <style
      is:inline
      set:html={`#${uid}{background-image:url('${narrow}')}
@media (min-width:760px){#${uid}{background-image:url('${wide}')}}`}
    />
  )
}

<div class="cine" data-cine data-bez-snimka={estSnimok ? undefined : 'true'}>
  <div
    class="cine__plate"
    id={uid}
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    style={`background-position: ${position}`}
  >
  </div>

  <div class="cine__light" aria-hidden="true"></div>
  <div class="cine__fog cine__fog--a" aria-hidden="true"></div>
  <div class="cine__fog cine__fog--b" aria-hidden="true"></div>
  <div class="cine__grain" aria-hidden="true"></div>
  <div class="cine__scrim" aria-hidden="true"></div>

  <div class="cine__content">
    <slot />
  </div>
</div>

<script>
  // Единственное, ради чего здесь нужен JS: не гонять композитор, когда кадр
  // не виден. Всё остальное делает CSS.
  const frames = document.querySelectorAll('[data-cine]');
  if (frames.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          e.target.dataset.paused = e.isIntersecting ? 'false' : 'true';
        });
      },
      { rootMargin: '120px' }
    );
    frames.forEach((f) => io.observe(f));

    document.addEventListener('visibilitychange', () => {
      frames.forEach((f) => {
        if (document.hidden) f.dataset.paused = 'true';
        else f.dataset.paused = 'false';
      });
    });
  }
</script>

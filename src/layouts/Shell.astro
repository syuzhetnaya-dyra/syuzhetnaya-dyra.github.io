---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import '../styles/world.css';
import '../styles/cinematic.css';
import { asset } from '../scripts/paths.js';

import { platno, METKA_NACHALO, METKA_KONEC, SSYLKA_OPLATY, KONTAKTY } from '../data/dostup.js';
import { CENA_AKTSIYA, CENA_POSLE, SROK_SLOVAMI, aktsiyaIdyot, rubli } from '../data/aktsiya.js';
import { to } from '../scripts/paths.js';

const { title, screen = '', description, work = '', heroes = 0 } = Astro.props;

/*
 * Замок ставится только на страницах платного произведения и только там,
 * где есть что закрывать. Главная и список произведений остаются открытыми
 * всегда: человек должен видеть, что он покупает.
 */
const podZamkom = Boolean(work) && platno(work, screen);

/*
 * Состояние стартовой скидки на момент сборки. Правду при загрузке
 * поставит src/scripts/aktsiya.js: страница, собранная до срока, у
 * посетителя после срока обязана показать другое.
 */
const aktsiya = aktsiyaIdyot();

// Продаём, если есть куда отправить покупателя: постоянная ссылка на
// оплату или хотя бы личка, где выставят счёт руками.
const prodayom = Boolean(SSYLKA_OPLATY) || KONTAKTY.length > 0;
// На главной заголовок и есть «Сюжетная дыра» — приписывать его второй раз
// значит выдать вкладку «Сюжетная дыра — Сюжетная дыра».
const pageTitle = title === 'Сюжетная дыра' ? title : `${title} — Сюжетная дыра`;

// Описание собрано из продуктовой правды (@PRODUCT.md), а не сочинено под SEO.
const desc =
  description ||
  'Тренажёр задания №2 ЕГЭ по литературе на материале «Ионыча» Чехова: досье героев, сюжетный чек и тест-дыра. Цитаты с главой и говорящим.';

/*
 * Абсолютный адрес нужен только карточке ссылки: мессенджеры и соцсети не
 * умеют относительные пути в og:image. Astro.site задаётся в astro.config,
 * и пока он не задан, карточка просто не подставится — страница от этого не
 * ломается.
 */
const origin = Astro.site ? Astro.site.origin : '';
const shareImage = origin ? new URL(asset('brand/share.jpg'), origin).href : '';
const canonical = origin ? new URL(Astro.url.pathname, origin).href : '';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />

    {/*
      noindex оставлен намеренно. Формат задания №2 пока опирается на файлы
      заказчика, а не на сверенную демоверсию ФИПИ (см. «Открытые вопросы» в
      STRUCTURE.md) — до сверки звать поисковый трафик рано. Прямая ссылка
      при этом работает у любого: noindex закрывает только поиск.
      Убрать — одна строка.
    */}
    <meta name="robots" content="noindex" />

    <link rel="icon" href={asset('brand/logo-mark.png')} type="image/png" />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Карточка ссылки: без этого в мессенджере видно голый адрес. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Сюжетная дыра" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      shareImage && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Сюжетная дыра — тренажёр задания №2 ЕГЭ по литературе" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={shareImage} />
        </>
      )
    }
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Prata&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Literata:opsz,wght@7..72,400;7..72,500&family=Inter:wght@400;500;600&display=swap"
    />
    <!-- Переходы между страницами: карточка героя перетекает в его разворот -->
    <ClientRouter />
  </head>
  <body data-screen={screen} data-work={work} data-heroes={heroes || undefined}>
    <div class="stage">
      {podZamkom && <Fragment set:html={METKA_NACHALO} />}
      <slot />
      {podZamkom && <Fragment set:html={METKA_KONEC} />}

      {
        podZamkom && (
          <form class="zamok" data-zamok-forma hidden>
            <div class="zamok__list">
            <p class="zamok__title">Нужен код доступа</p>

            {
              prodayom ? (
                <Fragment>
                  <p class="zamok__lead">
                    Доступ ко всем произведениям — <b data-cena>{rubli(aktsiya ? CENA_AKTSIYA : CENA_POSLE)}</b>{' '}
                    за 12 месяцев с момента оплаты, разовый платёж, без автопродления. «Ионыч»
                    разобран целиком и открыт всем — посмотрите его, если ещё не видели.
                  </p>

                  {SSYLKA_OPLATY ? (
                    <Fragment>
                      {/*
                        Два состояния сразу, переключает src/scripts/aktsiya.js.
                        Ссылка выставлена на сумму стартовой скидки и после срока
                        списала бы её же, поэтому по истечении акции кнопка
                        отключается, а не меняет цену.
                      */}
                      <div data-aktsiya hidden={!aktsiya}>
                        <a
                          class="zamok__kupit"
                          href={SSYLKA_OPLATY}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Получить доступ за {rubli(CENA_AKTSIYA)}
                        </a>
                        <p class="zamok__kak">
                          Стартовая скидка — только до {SROK_SLOVAMI}. Код придёт после оплаты.
                        </p>
                      </div>

                      <div data-posle hidden={aktsiya}>
                        <p class="zamok__kak">Напишите мне — пришлю счёт и код:</p>
                        <ul class="zamok__svyaz">
                          {KONTAKTY.map((k) => (
                            <li>
                              <a class="zamok__kupit" href={k.ssylka} rel="noopener" target="_blank">
                                {k.imya} <span class="zamok__nik">{k.nik}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </Fragment>
                  ) : (
                    <Fragment>
                      {/* Пока продажа ручная, кнопка ведёт не на оплату, а в личку:
                          там выставляется счёт и туда же приходит код. */}
                      <p class="zamok__kak">Напишите мне — пришлю реквизиты и код:</p>
                      <ul class="zamok__svyaz">
                        {KONTAKTY.map((k) =>
                          k.ssylka ? (
                            <li>
                              <a class="zamok__kupit" href={k.ssylka} rel="noopener" target="_blank">
                                {k.imya} <span class="zamok__nik">{k.nik}</span>
                              </a>
                            </li>
                          ) : (
                            <li>
                              <span class="zamok__kupit zamok__kupit--tiho">
                                {k.imya} <span class="zamok__nik">{k.nik}</span>
                              </span>
                            </li>
                          )
                        )}
                      </ul>
                    </Fragment>
                  )}
                </Fragment>
              ) : (
                <Fragment>
                  <p class="zamok__lead">
                    Продажа доступа пока не открыта — кода ещё нельзя купить, и это честнее сказать
                    прямо. А «Ионыч» разобран целиком и открыт всем: там тот же разбор, те же цитаты и
                    те же задания.
                  </p>
                  <a class="zamok__kupit" href={to('/ionych/')}>
                    Открыть «Ионыча»
                  </a>
                </Fragment>
              )
            }
            <label class="zamok__pole">
              <span class="zamok__podpis">Уже есть код?</span>
              <input
                type="text"
                inputmode="latin"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                placeholder="XXXX-XXXX-XXXX"
                aria-describedby="zamok-beda"
              />
            </label>
            <button class="zamok__knopka" type="submit">
              Открыть
            </button>
            <p class="zamok__beda" id="zamok-beda" data-zamok-beda hidden />
            <p class="zamok__snoska">
              Введите код, отправленный Вам на почту. Просто вводите его каждый раз, когда захотите
              войти&#160;❤️
            </p>
            </div>
          </form>
        )
      }
    </div>

    {/* Холст только там, где лепестки играют: на страницах заданий пустой
        canvas тянул бы за собой 513 КБ движка ради ничего. */}
    {screen === 'title' && <canvas class="petals" aria-hidden="true"></canvas>}

    <script>
      import { mountSlideNav } from '../scripts/nav.js';
      import { mountMetrika } from '../scripts/metrika.js';
      import { mountZamok } from '../scripts/zamok.js';
      import { mountAktsiya } from '../scripts/aktsiya.js';

      // Замок снимается один раз за загрузку, а не на каждом astro:page-load:
      // он сам это событие и рассылает, когда содержимое расшифровано.
      mountZamok();

      // Цена и отсчёт — сразу, не дожидаясь astro:page-load: он приходит
      // после загрузки картинок, и до тех пор в клетках отсчёта стояли бы
      // прочерки. Второй вызов ниже не плодит интервалов — mountAktsiya
      // гасит предыдущий.
      mountAktsiya();

      // astro:page-load срабатывает и на первой загрузке, и после каждого
      // перехода — модульный скрипт сам по себе второй раз не выполнится.
      document.addEventListener('astro:page-load', () => {
        // Счётчик поднимается на каждой странице: цели ставятся в чеке и в
        // тест-дыре, и без него они просто не отправятся.
        mountMetrika();
        mountSlideNav();
        // Цена и состояние стартовой скидки есть и в замке: собранная
        // страница про срок не знает, знает только браузер.
        mountAktsiya();
      });
    </script>
  </body>
</html>

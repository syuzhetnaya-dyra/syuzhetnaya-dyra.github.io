---
import Shell from '../layouts/Shell.astro';
import Header from '../components/Header.astro';
import CinematicPhoto from '../components/CinematicPhoto.astro';
import HeroTitle from '../components/HeroTitle.astro';
import Scrap from '../components/Scrap.astro';
import { work, heroes, family, checks, plural } from '../data/ionych.js';
import { warmup, matching, terms } from '../data/zadaniya.js';
import { to, asset } from '../scripts/paths.js';

const heroCount = heroes.length + 1;
const questionCount = Object.values(checks).reduce((n, list) => n + list.length, 0) + 1;
// Столько заданий действительно лежит в тест-дыре: задания № 1, № 2 и № 3.
const taskCount = warmup.length + matching.length + terms.length;

const cast = [{ ...family, anchor: 'turkiny' }, ...heroes.map((h) => ({ ...h, anchor: h.id }))];
---

<Shell title={work.title} screen="title">
  <Header />

  <CinematicPhoto
    src={asset('hero/ionych-1680.jpg')}
    srcNarrow={asset('hero/ionych-900.jpg')}
    alt=""
    position="center 42%"
  >
    <div class="hero">
      <HeroTitle text={work.title} />

      <div class="hero__act">
        <a class="hero__cta" href={to('ionych/dosye/')} data-petal-link>
          Начать тренировку
          <span class="hero__cta-arrow" aria-hidden="true">→</span>
        </a>
        <p class="hero__meta">
          {heroCount} досье · {questionCount}{' '}
          {plural(questionCount, 'вопрос', 'вопроса', 'вопросов')} · {taskCount}{' '}
          {plural(taskCount, 'типовое задание', 'типовых задания', 'типовых заданий')}
        </p>
      </div>

    </div>
  </CinematicPhoto>

  <section class="why" aria-labelledby="why-h">
    <h2 class="why__h" id="why-h">Зачем это</h2>
    <div class="why__scraps">
      <Scrap side="left" seed={7} tilt="-1.6deg">
        <p class="scrap__label">Что мы делаем</p>
        <p class="scrap__text">
          Делаем литературу живой: герои и детали, которые обычно остаются
          за кадром, но встречаются в ЕГЭ.
        </p>
      </Scrap>

      <Scrap side="right" seed={23} tilt="1.4deg">
        <p class="scrap__label">Задание №2</p>
        <p class="scrap__text">
          Цитаты, которые закрывают задание №2 ЕГЭ по литературе — с главой,
          говорящим и разбором, почему верна именно эта.
        </p>
      </Scrap>
    </div>
  </section>

  <section class="cast" aria-labelledby="cast-h">
    <h2 class="cast__h" id="cast-h">Действующие лица</h2>

    {/* Лента едет, пока её не трогают: наведение, фокус с клавиатуры и палец
        на экране её останавливают — иначе имя уезжает из-под пальца.
        Второй проход ленты — копия для бесшовной петли, от чтения с экрана
        и от Tab она скрыта. При prefers-reduced-motion лента стоит и
        листается пальцем. */}
    <div class="cast__lane">
      <ul class="cast__track">
        {
          cast.map((c) => (
            <li>
              <a class="cast__item" href={to(`ionych/dosye/#${c.anchor}`)}>
                <span class="cast__name">{c.name}</span>
                <span class="cast__role">{c.aka ? `«${c.aka}»` : c.role}</span>
              </a>
            </li>
          ))
        }
        {
          cast.map((c) => (
            <li aria-hidden="true">
              <a class="cast__item" href={to(`ionych/dosye/#${c.anchor}`)} tabindex="-1">
                <span class="cast__name">{c.name}</span>
                <span class="cast__role">{c.aka ? `«${c.aka}»` : c.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    import { mountTitleScene, armSceneLinks } from '../scripts/petals.js';
    import { goal } from '../scripts/metrika.js';
    // Лепестки живут только на этом экране: здесь они играют фоном, и отсюда
    // переход в тренажёр — настоящая смена сцены (§6.3, §8). На страницах
    // заданий движок не грузится вовсе.
    document.addEventListener('astro:page-load', () => {
      mountTitleScene({ count: window.innerWidth < 760 ? 6 : 10 });
      armSceneLinks();

      // Нажатие на главную кнопку — вершина воронки.
      document
        .querySelector('.hero__cta')
        ?.addEventListener('click', () => goal('start-training'));
    });
  </script>
</Shell>

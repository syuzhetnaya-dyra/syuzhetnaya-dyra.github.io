---
import Shell from '../../../layouts/Shell.astro';
import Header from '../../../components/Header.astro';
import RollText from '../../../components/RollText.astro';
import { family, heroes, checks, plural } from '../../../data/ionych.js';
import { to, asset } from '../../../scripts/paths.js';
import { rim } from '../../../scripts/rim.js';

const cards = [
  { ...family, isFamily: true, photo: 'turkiny' },
  ...heroes.map((h) => ({ ...h, photo: h.id })),
];

export function getStaticPaths() {
  const list = [
    { ...family, isFamily: true, photo: 'turkiny' },
    ...heroes.map((h) => ({ ...h, photo: h.id })),
  ];
  return list.map((c, i) => ({
    params: { hero: c.photo },
    props: { index: i },
  }));
}

const { hero } = Astro.params;
const { index } = Astro.props;

const card = cards[index];

const prev = cards[(index - 1 + cards.length) % cards.length];
const next = cards[(index + 1) % cards.length];

/*
 * Оживление портрета. Комбинация подобрана под каждый снимок — ни одному не
 * дано всё сразу, иначе шесть разворотов выглядят одинаково «анимированными».
 *
 *   dur  — период дыхания, с
 *   amp  — ход по вертикали, px
 *   tilt — наклон на крайних точках, град (0 — наклона нет)
 *   par  — сила параллакса от курсора, px (0 — параллакса нет)
 */
const MOTION = {
  // Групповая сцена: наклон перекосил бы весь стол, поэтому только дыхание.
  turkiny: { dur: 8.6, amp: 5, tilt: 0, par: 0 },
  // Одна фигура по центру кадра — есть на чём показать наклон и параллакс.
  ivan: { dur: 7.2, amp: 7, tilt: 0.5, par: 8 },
  // Сидит прямо и читает: наклон читался бы как качание на стуле.
  vera: { dur: 9, amp: 6, tilt: 0, par: 7 },
  // За роялем — ход вверх-вниз подхватывает движение игры.
  kotik: { dur: 6.6, amp: 8, tilt: 0.7, par: 0 },
  // Две фигуры по диагонали: параллакс слегка разводит их по глубине.
  starcev: { dur: 8, amp: 6, tilt: 0.4, par: 9 },
  // Трое в ряд, кадр широкий: хватает наклона, вертикали почти не нужно.
  sluga: { dur: 7.8, amp: 5, tilt: 0.6, par: 0 },
};
const m = MOTION[card.photo] || { dur: 8, amp: 5, tilt: 0, par: 0 };

// Сдвиг фазы, чтобы снимок не стартовал строго из нижней точки.
const phase = -(index * 1.37).toFixed(2);

/*
 * Строки делятся ПОПОЛАМ, а не через одну.
 *
 * Через одну порядок в разметке стал бы 1, 3, 5 … 2, 4, 6 — и на телефоне,
 * где колонка одна, досье читалось бы вперемешку. Половинами порядок
 * сохраняется: слева первая половина, справа вторая, и это же обычный
 * порядок чтения двухколоночного разворота.
 *
 * Два отдельных списка, а не один на общей сетке: в прежней раскладке под
 * каждую строку заводился ряд сетки, и раскрытая цитата слева заставляла
 * правую сторону пустовать на ту же высоту. Независимые колонки растут
 * каждая сама по себе.
 */
const half = Math.ceil(card.rows.length / 2);
const left = card.rows.slice(0, half);
const right = card.rows.slice(half);
---

<Shell title={`${card.name} · Досье`} screen="hero">
  <Header work="ionych" active="dosye" />

  {/*
    Портрет по центру, досье по краям. Строки закрыты: на плашке стоит, о чём
    речь, цитата выезжает по нажатию — на этом раскладка и держится. Прежде,
    когда цитаты были раскрыты всегда, такая же расстановка оставляла белые
    поля: под каждой строкой пустовала противоположная сторона. Закрытые
    плашки низкие и одинаковые, а колонки независимы, поэтому раскрытая
    цитата растит только свою сторону.

    Снимок стоит первым в разметке: на телефоне колонка одна, и он должен
    быть сверху. В середину его ставит явное grid-column, а не order.
  */}
  <article class="spread">
    <header class="spread__head">
      <span class="spread__badge" aria-hidden="true">{rim(index + 1)}</span>
      <p class="spread__label">{card.group || card.role}</p>
      <h1 class="spread__name">{card.name}</h1>
      {card.aka && <p class="spread__aka">«{card.aka}»</p>}
      <p class="spread__hint">Нажмите на строку — выедет цитата с главой.</p>
    </header>

    <div class="spread__grid" data-spread>
      <div class="spread__photo" data-portrait style={`--par: ${m.par}px`}>
        <div class="spread__photo-rev">
          <img
            class="spread__img"
            src={asset(`heroes/cut/${card.photo}.webp`)}
            alt=""
            width="820"
            height="1230"
            fetchpriority="high"
            decoding="async"
            style={`--fd: ${m.dur}s; --fa: ${m.amp}px; --ft: ${m.tilt}deg; --fp: ${phase}s; view-transition-name: hero-${card.photo}`}
          />
        </div>
      </div>

      {
        [
          { rows: left, side: 'left', from: 0 },
          { rows: right, side: 'right', from: half },
        ].map(({ rows, side, from }) => (
          <ol class="spread__rows" data-side={side}>
            {rows.map((r, k) => {
              const i = from + k;
              return (
                <li class="spread__row" style={`--i: ${i}`}>
                  <button
                    class="spread__q"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`row-${i}`}
                    data-row-q
                  >
                    <span class="spread__q-text">{r.key}</span>
                    <span class="spread__q-sign" aria-hidden="true"></span>
                  </button>

                  <div class="spread__a" id={`row-${i}`} data-row-a>
                    <div class="spread__a-in">
                      {/* Кавычки в тексте, а не псевдоэлементом: иначе
                          закрывающая срывается на отдельную строку. */}
                      {r.quote && (
                        <blockquote class="ds-quote"><RollText text={`«${r.quote}»`} /></blockquote>
                      )}
                      {r.quote && r.chapter && <p class="ds-ch">глава {r.chapter}</p>}
                      {r.value && <p class="ds-value"><RollText text={r.value} /></p>}
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        ))
      }
    </div>

    <div class="spread__foot">
      {
        !card.isFamily && checks[card.id] ? (
          <a class="ds-go" href={to(`ionych/check/?hero=${card.id}`)}>
            Отработать в чеке
            <span class="ds-go__n">
              {checks[card.id].length}{' '}
              {plural(checks[card.id].length, 'вопрос', 'вопроса', 'вопросов')}
            </span>
          </a>
        ) : (
          <p class="ds-nocheck">
            У семьи нет своего блока в чеке — её факты разобраны внутри каждого
            из Туркиных.
          </p>
        )
      }

      <a class="spread__back" href={to('ionych/dosye/')}>Вся колода</a>
    </div>

    <nav class="sheetdoc__nav" aria-label="Соседние герои">
      <a class="sheetdoc__step" href={to(`ionych/dosye/${prev.photo}/`)}>
        <span class="sheetdoc__dir">← предыдущий</span>
        <span class="sheetdoc__who">{prev.name}</span>
      </a>
      <a class="sheetdoc__step sheetdoc__step--next" href={to(`ionych/dosye/${next.photo}/`)}>
        <span class="sheetdoc__dir">следующий →</span>
        <span class="sheetdoc__who">{next.name}</span>
      </a>
    </nav>
  </article>

  <script>
    import { mountRows } from '../../../scripts/rows.js';
    import { mountPortrait } from '../../../scripts/portrait.js';

    document.addEventListener('astro:page-load', () => {
      mountRows();
      mountPortrait();
    });
  </script>
</Shell>
